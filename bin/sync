#!/usr/bin/env bash
# Sync the coding-agents config into a consumer repo.
# Usage: bin/sync [target-dir]   (defaults to $PWD)
#
# - Symlinks every skill into .claude/skills/ and .agents/skills/
# - Symlinks every prompt into .claude/commands/ (Codex reads ~/.codex/prompts globally)
# - Generates AGENTS.md = rules/base.md + agents.local.md
# - Symlinks CLAUDE.md → AGENTS.md
# Idempotent: safe to re-run.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

TARGET="${1:-$PWD}"
TARGET="$(cd "$TARGET" && pwd)"

if [ "$TARGET" = "$CONFIG_DIR" ]; then
  echo "Refusing to sync into the config repo itself."
  exit 1
fi

relpath() {
  # Cross-platform relative-path: target=$1, base=$2
  python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$1" "$2"
}

link_into() {
  # link_into <source-path> <link-path>
  local src="$1" link="$2"
  local rel
  rel="$(relpath "$src" "$(dirname "$link")")"
  if [ -L "$link" ]; then
    rm "$link"
  elif [ -e "$link" ]; then
    echo "  ! $link exists and is not a symlink — skipping"
    return
  fi
  ln -s "$rel" "$link"
  echo "  + $(relpath "$link" "$TARGET")"
}

echo "Syncing → $TARGET"
echo "  source: $CONFIG_DIR"

# --- skills ---
for agent_path in ".claude/skills" ".agents/skills"; do
  mkdir -p "$TARGET/$agent_path"
  if [ -d "$CONFIG_DIR/skills" ]; then
    for skill_dir in "$CONFIG_DIR/skills"/*/; do
      [ -d "$skill_dir" ] || continue
      name="$(basename "$skill_dir")"
      link_into "${skill_dir%/}" "$TARGET/$agent_path/$name"
    done
  fi
done

# --- prompts (Claude slash commands) ---
if [ -d "$CONFIG_DIR/prompts" ]; then
  mkdir -p "$TARGET/.claude/commands"
  for p in "$CONFIG_DIR/prompts"/*.md; do
    [ -e "$p" ] || continue
    name="$(basename "$p")"
    link_into "$p" "$TARGET/.claude/commands/$name"
  done
fi

# --- agents.local.md (project-specific rules; user-edited) ---
LOCAL="$TARGET/agents.local.md"
if [ ! -f "$LOCAL" ]; then
  cat > "$LOCAL" <<'EOF'
# Project-specific rules

Anything in this file is appended to the shared base rules when `AGENTS.md` is generated.
Edit this file freely. `AGENTS.md` is regenerated on every sync, so don't edit it directly.
EOF
  echo "  + agents.local.md (new)"
fi

# --- AGENTS.md = base.md + agents.local.md ---
OUT="$TARGET/AGENTS.md"
{
  echo "<!-- Generated by coding-agents/bin/sync. Edit agents.local.md instead. -->"
  echo ""
  cat "$CONFIG_DIR/rules/base.md"
  echo ""
  echo "---"
  echo ""
  cat "$LOCAL"
} > "$OUT"
echo "  + AGENTS.md (generated)"

# --- CLAUDE.md → AGENTS.md ---
CLAUDE_LINK="$TARGET/CLAUDE.md"
if [ -e "$CLAUDE_LINK" ] && [ ! -L "$CLAUDE_LINK" ]; then
  echo "  ! CLAUDE.md exists and is not a symlink — leaving it alone"
else
  ln -sf "AGENTS.md" "$CLAUDE_LINK"
  echo "  + CLAUDE.md → AGENTS.md"
fi

echo "Done."
