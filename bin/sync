#!/usr/bin/env bash
# Sync the coding-agents config into a consumer repo.
# Usage: bin/sync [target-dir]   (defaults to $PWD)
# Preferred entrypoint: bin/coding-agents install [target-dir]
#
# - Symlinks every shared skill into .claude/skills/ and .agents/skills/
# - Symlinks every repo-local skill from .agent-local/skills/ into both agent skill dirs
# - Symlinks every prompt into .claude/commands/ (Codex reads ~/.codex/prompts globally)
# - Treats rules/base.md as the shared instruction source
# - Treats agents.local.md as the repo-local instruction source
# - Generates AGENTS.md = rules/base.md + agents.local.md
# - Symlinks CLAUDE.md → AGENTS.md
# Idempotent: safe to re-run.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

TARGET="${1:-$PWD}"
TARGET="$(cd "$TARGET" && pwd)"

if [ "$TARGET" = "$CONFIG_DIR" ]; then
  echo "Refusing to sync into the config repo itself."
  exit 1
fi

relpath() {
  # Cross-platform relative-path: target=$1, base=$2
  python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$1" "$2"
}

is_generated_agents() {
  local file="$1"
  [ -f "$file" ] && grep -Fq "<!-- Generated by coding-agents/bin/sync." "$file"
}

write_default_local_rules() {
  local file="$1"
  cat > "$file" <<'EOF'
# Project-specific rules

Anything in this file is appended to the shared base rules when `AGENTS.md` is generated.
Edit this file freely. `AGENTS.md` is regenerated on every sync, so don't edit it directly.
EOF
}

migrate_agents_to_local_rules() {
  local agents_file="$1"
  local local_file="$2"
  local cutoff

  cutoff="$(
    awk '
      /^## 1\.[[:space:]]+Think before coding$/ { print NR; exit }
      /^## 1\.[[:space:]]+Think Before Coding$/ { print NR; exit }
    ' "$agents_file"
  )"

  {
    echo "# Project-specific rules"
    echo
    echo "Preserved from the repo's previous AGENTS.md during coding-agents sync."
    echo
    if [ -n "$cutoff" ]; then
      sed -n "1,$((cutoff - 1))p" "$agents_file"
    else
      cat "$agents_file"
    fi | awk '
      NR == 1 && ($0 == "# AGENTS.md" || $0 == "# CLAUDE.md") { next }
      /^This file provides guidance to / { next }
      { print }
    '
  } > "$local_file"
}

link_into() {
  # link_into <source-path> <link-path>
  local src="$1" link="$2"
  local rel
  rel="$(relpath "$src" "$(dirname "$link")")"
  if [ -L "$link" ]; then
    rm "$link"
  elif [ -e "$link" ]; then
    echo "  ! $link exists and is not a symlink — skipping"
    return
  fi
  ln -s "$rel" "$link"
  echo "  + $(relpath "$link" "$TARGET")"
}

echo "Syncing → $TARGET"
echo "  source: $CONFIG_DIR"

link_skill_set() {
  local source_dir="$1"
  local destination_dir="$2"

  [ -d "$source_dir" ] || return 0

  for skill_dir in "$source_dir"/*/; do
    [ -d "$skill_dir" ] || continue
    name="$(basename "$skill_dir")"
    link_into "${skill_dir%/}" "$destination_dir/$name"
  done
}

# --- skills ---
for agent_path in ".claude/skills" ".agents/skills"; do
  mkdir -p "$TARGET/$agent_path"
  link_skill_set "$CONFIG_DIR/skills" "$TARGET/$agent_path"
  link_skill_set "$TARGET/.agent-local/skills" "$TARGET/$agent_path"
done

# --- prompts (Claude slash commands) ---
if [ -d "$CONFIG_DIR/prompts" ]; then
  mkdir -p "$TARGET/.claude/commands"
  for p in "$CONFIG_DIR/prompts"/*.md; do
    [ -e "$p" ] || continue
    name="$(basename "$p")"
    link_into "$p" "$TARGET/.claude/commands/$name"
  done
fi

# --- agents.local.md (repo-local instructions; user-edited) ---
LOCAL="$TARGET/agents.local.md"
if [ ! -f "$LOCAL" ]; then
  if [ -f "$TARGET/AGENTS.md" ] && ! is_generated_agents "$TARGET/AGENTS.md"; then
    migrate_agents_to_local_rules "$TARGET/AGENTS.md" "$LOCAL"
    echo "  + agents.local.md (migrated from existing AGENTS.md)"
  else
    write_default_local_rules "$LOCAL"
    echo "  + agents.local.md (new)"
  fi
fi

# --- AGENTS.md = shared base + repo-local instructions ---
OUT="$TARGET/AGENTS.md"
{
  echo "<!-- Generated by coding-agents/bin/sync. Edit agents.local.md instead. -->"
  echo ""
  cat "$CONFIG_DIR/rules/base.md"
  echo ""
  echo "---"
  echo ""
  cat "$LOCAL"
} > "$OUT"
echo "  + AGENTS.md (generated)"

# --- CLAUDE.md → AGENTS.md ---
CLAUDE_LINK="$TARGET/CLAUDE.md"
if [ -e "$CLAUDE_LINK" ] && [ ! -L "$CLAUDE_LINK" ]; then
  echo "  ! CLAUDE.md exists and is not a symlink — leaving it alone"
else
  ln -sf "AGENTS.md" "$CLAUDE_LINK"
  echo "  + CLAUDE.md → AGENTS.md"
fi

echo "Done."
