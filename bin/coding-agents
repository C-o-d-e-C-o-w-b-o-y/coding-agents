#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<EOF
Usage:
  bin/coding-agents install [target-dir]
  bin/coding-agents sync [target-dir]
  bin/coding-agents update [target-dir]
  bin/coding-agents doctor [target-dir] [skill-name]
  bin/coding-agents list-skills
  bin/coding-agents new-skill <skill-name> <description>
  bin/coding-agents new-local-skill [target-dir] <skill-name> <description>

Commands:
  install     Install or refresh coding-agents into a repo.
  sync        Alias for install.
  update      Pull the latest coding-agents from git, then install into a repo.
  doctor      Show what is installed in a repo and whether skills are discoverable.
  list-skills List shared skills in this repo.
  new-skill   Scaffold a new skill under skills/<name>/SKILL.md.
  new-local-skill Scaffold a repo-local skill under .agent-local/skills/<name>/SKILL.md.
EOF
}

relpath() {
  python3 -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$1" "$2"
}

is_skill_dir() {
  local dir="$1"
  [ -d "$dir" ] && [ -f "$dir/SKILL.md" ]
}

list_skills() {
  local found=0
  for skill_dir in "$ROOT_DIR"/skills/*; do
    if is_skill_dir "$skill_dir"; then
      found=1
      basename "$skill_dir"
    fi
  done

  if [ "$found" -eq 0 ]; then
    echo "No skills found in $ROOT_DIR/skills"
  fi
}

install_repo() {
  "$ROOT_DIR/bin/sync" "${1:-$PWD}"
}

update_repo() {
  local target="${1:-$PWD}"

  if [ ! -d "$ROOT_DIR/.git" ]; then
    echo "Cannot update: $ROOT_DIR is not a git checkout." >&2
    exit 1
  fi

  echo "Updating coding-agents in $ROOT_DIR"
  git -C "$ROOT_DIR" pull --ff-only
  echo
  install_repo "$target"
}

doctor_repo() {
  local target="${1:-$PWD}"
  local skill_name="${2:-}"
  local abs_target
  abs_target="$(cd "$target" && pwd)"

  echo "coding-agents repo: $ROOT_DIR"
  echo "target repo: $abs_target"
  echo

  if [ -d "$ROOT_DIR/skills" ]; then
    echo "shared skills:"
    list_skills | sed 's/^/  - /'
  else
    echo "shared skills: missing"
  fi
  echo

  local agents_md="$abs_target/AGENTS.md"
  local claude_md="$abs_target/CLAUDE.md"
  local codex_dir="$abs_target/.agents/skills"
  local claude_dir="$abs_target/.claude/skills"
  local local_skill_dir="$abs_target/.agent-local/skills"

  if [ -f "$agents_md" ]; then
    echo "AGENTS.md: present"
  else
    echo "AGENTS.md: missing"
  fi

  if [ -L "$claude_md" ]; then
    echo "CLAUDE.md: symlink -> $(readlink "$claude_md")"
  elif [ -e "$claude_md" ]; then
    echo "CLAUDE.md: present (not a symlink)"
  else
    echo "CLAUDE.md: missing"
  fi

  for dir in "$codex_dir" "$claude_dir"; do
    if [ -d "$dir" ]; then
      echo
      echo "$(relpath "$dir" "$abs_target"):"
      local any=0
      for entry in "$dir"/*; do
        [ -e "$entry" ] || continue
        any=1
        if [ -L "$entry" ]; then
          echo "  - $(basename "$entry") -> $(readlink "$entry")"
        else
          echo "  - $(basename "$entry")"
        fi
      done
      if [ "$any" -eq 0 ]; then
        echo "  (empty)"
      fi
    else
      echo
      echo "$(relpath "$dir" "$abs_target"): missing"
    fi
  done

  echo
  if [ -d "$local_skill_dir" ]; then
    echo "$(relpath "$local_skill_dir" "$abs_target"):"
    local any_local=0
    for entry in "$local_skill_dir"/*; do
      [ -e "$entry" ] || continue
      any_local=1
      echo "  - $(basename "$entry")"
    done
    if [ "$any_local" -eq 0 ]; then
      echo "  (empty)"
    fi
  else
    echo "$(relpath "$local_skill_dir" "$abs_target"): missing"
  fi

  if [ -n "$skill_name" ]; then
    echo
    local codex_skill="$codex_dir/$skill_name"
    local claude_skill="$claude_dir/$skill_name"
    local shared_skill="$ROOT_DIR/skills/$skill_name"
    local local_skill="$local_skill_dir/$skill_name"

    if is_skill_dir "$shared_skill"; then
      echo "shared skill '$skill_name': present"
    else
      echo "shared skill '$skill_name': missing from coding-agents"
    fi

    if is_skill_dir "$local_skill"; then
      echo "local-only skill '$skill_name': present"
    else
      echo "local-only skill '$skill_name': not present"
    fi

    if [ -e "$codex_skill" ]; then
      echo "codex skill '$skill_name': installed"
    else
      echo "codex skill '$skill_name': not installed"
    fi

    if [ -e "$claude_skill" ]; then
      echo "claude skill '$skill_name': installed"
    else
      echo "claude skill '$skill_name': not installed"
    fi
  fi

  echo
  echo "If you just installed or changed skills, restart the agent app to pick them up."
}

scaffold_skill() {
  local dir="$1"
  local name="$2"
  local description="$3"
  local next_step="$4"
  local file="$dir/SKILL.md"

  if [ -e "$dir" ]; then
    echo "Skill already exists: $dir" >&2
    exit 1
  fi

  mkdir -p "$dir"
  cat > "$file" <<EOF
---
name: $name
description: $description
---

TODO: Write the skill instructions here.
EOF

  echo "Created $file"
  echo "Next steps:"
  echo "  1. Fill in the instructions."
  echo "  2. $next_step"
  echo "  3. Restart the agent app."
}

new_skill() {
  local name="${1:-}"
  local description="${2:-}"

  if [ -z "$name" ] || [ -z "$description" ]; then
    echo "Usage: bin/coding-agents new-skill <skill-name> <description>" >&2
    exit 1
  fi

  if [[ ! "$name" =~ ^[a-z0-9-]+$ ]]; then
    echo "Skill name must be lowercase kebab-case: $name" >&2
    exit 1
  fi

  scaffold_skill "$ROOT_DIR/skills/$name" "$name" "$description" \
    "Run bin/coding-agents install /path/to/consumer-repo"
}

new_local_skill() {
  local target="${1:-}"
  local name="${2:-}"
  local description="${3:-}"

  if [ -z "$description" ]; then
    echo "Usage: bin/coding-agents new-local-skill [target-dir] <skill-name> <description>" >&2
    exit 1
  fi

  if [[ ! "$name" =~ ^[a-z0-9-]+$ ]]; then
    echo "Skill name must be lowercase kebab-case: $name" >&2
    exit 1
  fi

  local abs_target
  abs_target="$(cd "$target" && pwd)"

  scaffold_skill "$abs_target/.agent-local/skills/$name" "$name" "$description" \
    "Run $ROOT_DIR/bin/coding-agents install $abs_target"
}

command="${1:-}"

if [ -z "$command" ]; then
  usage
  exit 1
fi

shift

case "$command" in
  install|sync)
    install_repo "${1:-$PWD}"
    ;;
  update)
    update_repo "${1:-$PWD}"
    ;;
  doctor)
    doctor_repo "${1:-$PWD}" "${2:-}"
    ;;
  list-skills)
    list_skills
    ;;
  new-skill)
    new_skill "${1:-}" "${2:-}"
    ;;
  new-local-skill)
    if [ $# -eq 2 ]; then
      new_local_skill "$PWD" "${1:-}" "${2:-}"
    else
      new_local_skill "${1:-}" "${2:-}" "${3:-}"
    fi
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
